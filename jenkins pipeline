pipeline {
    agent any
    
    stages {
        stage('checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/monikakapur/Docker-Jenkins-Project.git'
            }
        }
        stage('build') {
            steps {
                sh 'docker build -t $image .'
            }
        }
        stage('tag') {
            steps {
                sh 'docker tag $image $repo'
            }
        }
        stage('push') {
            steps {
                sh 'docker login -u monikakapur22 -p $password'
                sh 'docker push $repo'
            }
        }
        stage('deploy') {
            steps {
                sh 'docker stack deploy bank -c docker-compose.yml'
            }
        }
    }
}
